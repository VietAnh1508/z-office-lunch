{
  "name": "z-office-lunch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:hot": "bash scripts/dev-hot.sh",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:stop": "bash scripts/dev-stop.sh",
    "build": "pnpm --filter web build",
    "deploy": "pnpm build && pnpm --filter api deploy",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter db generate",
    "db:migrate": "pnpm --filter db migrate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "tasks:status": "node scripts/task-status.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
