{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "z-office-lunch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "59de2634f51b4b46894226f550915bd4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MENU_IMAGES",
      "bucket_name": "z-office-lunch-menu-images"
    }
  ]
}
