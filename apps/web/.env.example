# Copy to .env for local dev. Gates /admin behind this password — baked into the
# built JS bundle, so treat it as a deterrent, not a secret (see docs/architecture.md).
# A real (non-empty) default so a fresh checkout's /admin is actually openable
# without an extra manual step — change it locally if you want, it's gitignored.
VITE_ADMIN_PASSWORD=dev-password
